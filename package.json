{
  "name": "agentdeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "build": "pnpm -r build && node scripts/build-assets.mjs",
    "check": "pnpm -r check && eslint .",
    "test": "vitest run",
    "test:integration": "vitest run bridge/test/integration.test.ts",
    "smoke:codex": "tsx scripts/smoke-codex.ts",
    "start": "node bridge/dist/bridge/src/main.js",
    "dev": "tsx bridge/src/main.ts",
    "schema:verify": "tsx scripts/schema.ts verify",
    "schema:record": "tsx scripts/schema.ts record",
    "verify:windows": "tsx scripts/verify-windows.ts",
    "verify:sandbox": "tsx scripts/verify-sandbox.ts",
    "smoke:bridge": "tsx scripts/real-bridge-smoke.ts",
    "smoke:approval": "tsx scripts/real-approval-smoke.ts",
    "package:windows": "node scripts/package-windows.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "typescript-eslint": "8.46.2",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/node": "22.18.12"
  }
}

{
  "name": "agentdeck",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "web:dev": "pnpm --filter @agentdeck/web dev",
    "build": "pnpm host:build",
    "check": "pnpm -r check && eslint .",
    "test:composer-preferences": "node --test scripts/web/test-composer-preferences.mjs",
    "test:file-workspace": "node --test scripts/web/test-file-workspace.mjs",
    "start": "node scripts/host/dev.mjs --start",
    "dev": "pnpm host:dev",
    "schema:verify": "node scripts/protocol/schema.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "host:build": "cargo build --release --locked --manifest-path desktop/core/Cargo.toml --bins",
    "host:dev": "node scripts/host/dev.mjs",
    "host:package": "node scripts/host/package.mjs",
    "test:composer-browser": "node scripts/web/test-composer-browser.mjs",
    "test:message-images-browser": "node scripts/web/test-message-images-browser.mjs",
    "test:host-names": "node --test scripts/web/test-host-names.mjs",
    "test:selection-quote-browser": "node scripts/web/test-selection-quote-browser.mjs",
    "test:file-references-browser": "node scripts/web/test-file-references-browser.mjs",
    "test:api-chat-browser": "node scripts/web/test-api-chat-browser.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.18.12",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "ws": "8.21.0"
  }
}

{
  "name": "agentdeck",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "desktop:dev": "pnpm desktop:prepare && node scripts/desktop/dev-desktop.mjs",
    "desktop:prepare": "node scripts/desktop/prepare-native-desktop.mjs",
    "desktop:build": "pnpm desktop:prepare && pnpm --filter @agentdeck/desktop desktop:build",
    "desktop:test": "pnpm --filter @agentdeck/desktop test && cargo test --locked --manifest-path desktop/core/Cargo.toml && cargo test --locked --manifest-path desktop/src-tauri/Cargo.toml",
    "native:check": "node scripts/checks/verify-native-runtime.mjs",
    "build": "pnpm --filter @agentdeck/desktop build",
    "check": "pnpm -r check && eslint .",
    "test": "pnpm desktop:test",
    "test:integration": "cargo test --locked --manifest-path desktop/core/Cargo.toml --test native",
    "smoke:codex": "cargo test --locked --manifest-path desktop/core/Cargo.toml --test real real_codex -- --ignored --nocapture",
    "start": "node scripts/desktop/launch-desktop.mjs",
    "dev": "pnpm desktop:dev",
    "schema:verify": "node scripts/protocol/schema.mjs",
    "package:windows": "node scripts/desktop/package-desktop.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.18.12",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "ws": "8.21.0"
  }
}

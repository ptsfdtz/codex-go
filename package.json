{
  "name": "agentdeck",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "web:dev": "pnpm --filter @agentdeck/web dev",
    "native:check": "node scripts/checks/verify-native-runtime.mjs",
    "build": "pnpm host:build",
    "check": "pnpm -r check && eslint .",
    "test": "pnpm host:test",
    "test:integration": "cargo test --locked --manifest-path desktop/core/Cargo.toml --test native",
    "smoke:codex": "cargo test --locked --manifest-path desktop/core/Cargo.toml --test real real_codex -- --ignored --nocapture",
    "start": "node scripts/host/dev.mjs --start",
    "dev": "pnpm host:dev",
    "schema:verify": "node scripts/protocol/schema.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "host:build": "cargo build --release --locked --manifest-path desktop/core/Cargo.toml --bin agentdeck --bin agentdeck-service",
    "host:test": "cargo test --locked --manifest-path desktop/core/Cargo.toml",
    "host:dev": "node scripts/host/dev.mjs",
    "host:package": "node scripts/host/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.18.12",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "ws": "8.21.0"
  }
}

AGENTDECK_DOMAIN=agentdeck.example.com
# Comma-separated HTTPS browser origins; use the exact GitHub Pages origin.
AGENTDECK_WEB_ORIGINS=https://ptsfdtz.github.io
# Generate each value separately with: openssl rand -hex 32
# Use hexadecimal here so the database password is safe inside the connection URL.
AGENTDECK_DB_PASSWORD=replace-with-64-random-hex-characters
AGENTDECK_PROXY_TOKEN=replace-with-another-64-random-hex-characters
AGENTDECK_MAX_TUNNELS=1024

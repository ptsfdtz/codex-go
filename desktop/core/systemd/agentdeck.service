[Unit]
Description=AgentDeck Linux host
After=network-online.target agentdeck-runtime.service
Wants=network-online.target agentdeck-runtime.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=-%h/.config/agentdeck/host.env
Environment=AGENTDECK_DATA_DIR=%h/.local/state/agentdeck
ExecStart=%h/.local/bin/agentdeck host-run
StateDirectory=agentdeck
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/agentdeck

[Install]
WantedBy=default.target
